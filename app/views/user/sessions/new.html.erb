<%# locals: (email_address:) -%>
<%= render layout: "user/shared/frame" do %>
  <h1>ログイン</h1>

  <% if flash[:alert] %>
    <p role="alert"><%= flash[:alert] %></p>
  <% end %>

  <%= form_with url: login_path do |form| %>
    <div>
      <%= form.label :email_address, Member.human_attribute_name(:email_address) %>
      <%= form.email_field :email_address, value: email_address, required: true, autofocus: true, autocomplete: "username" %>
    </div>

    <div>
      <%= form.label :password, Member.human_attribute_name(:password) %>
      <%= form.password_field :password, required: true, autocomplete: "current-password" %>
    </div>

    <%= form.submit "ログインする" %>
  <% end %>

  <p><%= link_to "会員登録はこちら", new_member_path %></p>
<% end %>
