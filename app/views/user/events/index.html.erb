<%# locals: (events:, applied_event_ids:) -%>
<%= render layout: "user/shared/frame" do %>
  <h1>イベント一覧</h1>

  <% if flash[:notice] %>
    <p role="status"><%= flash[:notice] %></p>
  <% end %>
  <% if flash[:alert] %>
    <p role="alert"><%= flash[:alert] %></p>
  <% end %>

  <% if events.empty? %>
    <p>受付中のイベントはありません</p>
  <% else %>
    <table>
      <thead>
        <tr>
          <th><%= Event.human_attribute_name(:title) %></th>
          <th>申込期間</th>
          <th>開催期間</th>
          <th>定員（男性／女性）</th>
          <th>申込</th>
        </tr>
      </thead>
      <tbody>
        <% events.each do |event| %>
          <tr>
            <td><%= event.title %></td>
            <td><%= l event.entry_start_at %> 〜 <%= l event.entry_end_at %></td>
            <td><%= l event.held_start_at %> 〜 <%= l event.held_end_at %></td>
            <td><%= event.male_capacity %>名／<%= event.female_capacity %>名</td>
            <td>
              <% if applied_event_ids.include?(event.id) %>
                申込済み
              <% else %>
                <%= button_to "申し込む", event_entry_path(event) %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <p><%= link_to "トップに戻る", root_path %></p>
<% end %>
