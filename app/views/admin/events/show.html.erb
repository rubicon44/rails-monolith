<%# locals: (event:) -%>
<%= render layout: "admin/shared/frame" do %>
  <h1><%= event.title %></h1>

  <dl>
    <dt><%= Event.human_attribute_name(:description) %></dt>
    <dd><%= simple_format event.description %></dd>

    <dt><%= Event.human_attribute_name(:venue_address) %></dt>
    <dd><%= event.venue_address %></dd>

    <dt>申込期間</dt>
    <dd><%= l event.entry_start_at %> 〜 <%= l event.entry_end_at %></dd>

    <dt>開催期間</dt>
    <dd><%= l event.held_start_at %> 〜 <%= l event.held_end_at %></dd>

    <dt>定員（男性／女性）</dt>
    <dd><%= event.male_capacity %>名／<%= event.female_capacity %>名</dd>

    <dt><%= Event.human_attribute_name(:entry_status) %></dt>
    <dd><%= Event.human_attribute_name("entry_status.#{event.entry_status}") %></dd>

    <dt><%= Event.human_attribute_name(:status) %></dt>
    <dd><%= Event.human_attribute_name("status.#{event.status}") %></dd>
  </dl>

  <p><%= link_to "イベント一覧に戻る", admin_events_path %></p>
<% end %>
